# Marloues 本地开发环境变量
# 复制此文件为 .env.local 并填入你的 API key
# .env.local 不会被提交到版本控制

# Anthropic API Key (必填)
ANTHROPIC_API_KEY=

# Anthropic Base URL (可选，默认 https://api.anthropic.com)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Build-time update configuration (official packaged builds)
# MARLOUES_BUILD_ENV=production
# MARLOUES_CLIENT_UPDATE_PROVIDER=github
# MARLOUES_CLIENT_UPDATE_URL=https://updates.example.com/marloues/client
# GitHub Pages 上已签名的 UI feed 根路径（不包含 stable/beta/nightly）
# MARLOUES_HOT_UPDATE_URL=https://marloues.github.io/marloues/ui
# MARLOUES_HOT_UPDATE_PUBLIC_KEYS_FILE=client/resources/hot-update-public-keys.json
# MARLOUES_REQUIRE_HOT_UPDATE=1
