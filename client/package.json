{
  "name": "marloues",
  "version": "0.2.0",
  "private": true,
  "description": "Multi-kernel Agent desktop workspace.",
  "author": "Marloues",
  "repository": {
    "type": "git",
    "url": "https://github.com/severnxu/marloues.git"
  },
  "engines": {
    "node": ">=22.22.1 <23",
    "npm": ">=10 <11"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --config electron.vite.config.ts",
    "build": "electron-vite build --config electron.vite.config.ts",
    "package:dir": "npm run build && electron-builder --dir --publish=never",
    "package:smoke": "npm run package:dir && npm run test:smoke:packaged",
    "package:mac": "npm run build && electron-builder --mac --publish=never",
    "package:win": "npm run build && electron-builder --win --publish=never",
    "package:linux": "npm run build && electron-builder --linux --publish=never",
    "release": "npm run build && electron-builder --publish=always",
    "key:hot": "node scripts/ensure-hot-update-key.mjs",
    "publish:hot": "node scripts/publish-hot-update.mjs",
    "prepare:hot-pages": "node scripts/prepare-hot-update-pages.mjs",
    "verify:hot": "node scripts/verify-hot-update.mjs",
    "start": "electron-vite preview --config electron.vite.config.ts",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3 -w node-pty",
    "install:playwright-browsers": "PLAYWRIGHT_BROWSERS_PATH=./resources/playwright-browsers npx playwright install chromium",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:contract": "npm run test:contract:redaction && npm run test:contract:runtime && npm run test:contract:hot-update-pages && npm run test:contract:release-packaging",
    "test:contract:release-packaging": "node ../tests/contract/release-packaging.contract.mjs",
    "test:contract:hot-update-pages": "node ../tests/contract/hot-update-pages.contract.mjs",
    "test:contract:runtime": "tsx --tsconfig tsconfig.node.json ../tests/contract/runtime.contract.ts",
    "test:contract:redaction": "tsx --tsconfig tsconfig.node.json ../tests/contract/redaction-rules.contract.ts",
    "test:smoke:runtime": "tsx --tsconfig tsconfig.node.json ../tests/smoke/runtime.smoke.ts",
    "test:smoke:process-sandbox": "tsx --tsconfig tsconfig.node.json ../tests/smoke/process-sandbox.smoke.ts",
    "test:smoke:live-runtime": "tsx --tsconfig tsconfig.node.json ../tests/smoke/live-runtime.smoke.ts",
    "test:smoke:binary-live": "tsx --tsconfig tsconfig.node.json ../tests/smoke/binary-live.smoke.ts",
    "test:smoke:electron-live-ui": "tsx --tsconfig tsconfig.node.json ../tests/smoke/electron-live-ui.smoke.ts",
    "test:smoke:electron-binary-live-ui": "tsx --tsconfig tsconfig.node.json ../tests/smoke/electron-live-ui.smoke.ts --binary",
    "test:smoke:packaged": "node ../tests/smoke/packaged.smoke.mjs",
    "test:smoke:terminal-browser": "tsx --tsconfig tsconfig.node.json ../tests/smoke/terminal-browser.smoke.ts",
    "test:contract:terminal-browser": "tsx --tsconfig tsconfig.node.json ../tests/contract/terminal-browser.contract.ts",
    "test:visual": "node ../tests/visual/workflow-suite.visual.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test --config playwright.config.ts --project=critical",
    "lint": "eslint --config eslint.config.mjs .",
    "format": "prettier --write \"**/*.{ts,tsx,css,json}\" \"../tests/**/*.{ts,tsx,json,md}\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^2.0.0",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@lezer/highlight": "^1.2.3",
    "@openai/codex": "0.149.1",
    "@pierre/diffs": "^1.2.10",
    "@types/qrcode": "^1.5.6",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "better-sqlite3": "^13.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "framer-motion": "^12.40.0",
    "hast-util-to-text": "^4.0.2",
    "highlight.js": "^11.11.1",
    "loge": "^1.0.5",
    "node-pty": "^1.1.0",
    "playwright": "^1.62.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "marked": "^17.0.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-diff-viewer-continued": "^3.4.0",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.11",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "unist-util-visit": "^5.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.5",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.marloues.desktop",
    "productName": "Marloues",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "resources/playwright-browsers",
        "to": "playwright-browsers",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "node_modules/@openai/codex-*/**",
      "node_modules/node-pty/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "severnxu",
        "repo": "marloues"
      }
    ],
    "afterSign": "./scripts/notarize.cjs",
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Marloues-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Marloues-${version}-${arch}-Setup.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "Marloues <severnxu@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Marloues-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Marloues"
    }
  }
}
