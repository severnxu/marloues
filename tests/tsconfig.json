{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "typeRoots": ["../client/node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@playwright/test": ["../client/node_modules/@playwright/test"]
    }
  },
  "include": ["e2e/**/*.ts"]
}
